// Fantasy Politics database schema.
//
// The schema covers all five build phases up front so later phases only need
// additive migrations. Tables marked "(Phase N)" are not used by the app yet.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums (keep in sync with packages/shared) ──────────────────────────────

enum Position {
  HEAD_OF_STATE
  FINANCE
  FOREIGN
  GOVERNOR
  MAYOR
  LEGISLATIVE
  OPPOSITION
}

enum PlayerStatus {
  ACTIVE
  CAMPAIGNING
  CARETAKER
  LAME_DUCK
  FACING_NO_CONFIDENCE
  LEFT_OFFICE
}

enum LeagueStatus {
  PRE_DRAFT
  DRAFTING
  IN_SEASON
  PLAYOFFS
  COMPLETE
}

enum DraftOrderMode {
  RANDOM
  MANUAL
}

enum DraftState {
  NOT_STARTED
  RUNNING
  PAUSED
  COMPLETE
}

// ─── Users & auth ───────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())

  teams           Team[]
  commissioned    League[]          @relation("Commissioner")
  passwordResets  PasswordReset[]
  chatMessages    ChatMessage[]
  loggedEvents    PlayerEvent[]
}

/// One-time password reset links, generated by an admin or commissioner
/// (no email provider in v1 — the link is shared manually).
model PasswordReset {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// ─── Leagues & teams ────────────────────────────────────────────────────────

model League {
  id             String       @id @default(cuid())
  name           String
  commissionerId String
  commissioner   User         @relation("Commissioner", fields: [commissionerId], references: [id])
  inviteCode     String       @unique
  status         LeagueStatus @default(PRE_DRAFT)
  season         Int          @default(1)

  // Settings (commissioner-editable before the draft)
  numTeams           Int            @default(8)
  /// Record<SlotType, number> — see packages/shared/src/positions.ts
  lineupSlots        Json
  benchSize          Int            @default(4)
  regularSeasonWeeks Int            @default(10)
  playoffTeams       Int            @default(4)
  timezone           String         @default("America/New_York")
  /// ScoringConfig — see packages/shared/src/scoring/config.ts
  scoringConfig      Json

  // Draft settings
  draftAt          DateTime?
  draftPickSeconds Int            @default(90)
  draftOrderMode   DraftOrderMode @default(RANDOM)
  draftState       DraftState     @default(NOT_STARTED)
  /// Deadline for the current pick (persisted so a restart can resume the timer)
  draftPickDeadline DateTime?
  /// Remaining ms on the clock when the draft was paused
  draftPausedRemainingMs Int?

  /// Monday (league-local date, YYYY-MM-DD) of regular-season week 1
  seasonStartDate String?
  currentWeek     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams       Team[]
  draftPicks  DraftPick[]
  rosterSpots RosterSpot[]
  matchups    Matchup[]
  activities  Activity[]
  chat        ChatMessage[]
  champions   ChampionRecord[]
  trades      Trade[]
  waiverClaims WaiverClaim[]
}

model Team {
  id             String   @id @default(cuid())
  leagueId       String
  league         League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User     @relation(fields: [ownerId], references: [id])
  name           String
  /// 1-based draft slot (null until the order is set)
  draftPosition  Int?
  /// Lower = higher priority (Phase 5)
  waiverPriority Int?
  createdAt      DateTime @default(now())

  rosterSpots  RosterSpot[]
  draftPicks   DraftPick[]
  queue        DraftQueueItem[]
  lineups      WeeklyLineup[]
  homeMatchups Matchup[] @relation("HomeTeam")
  awayMatchups Matchup[] @relation("AwayTeam")
  waiverClaims WaiverClaim[]
  tradesProposed Trade[] @relation("TradeProposer")
  tradesReceived Trade[] @relation("TradeRecipient")

  @@unique([leagueId, ownerId])
  @@unique([leagueId, name])
}

// ─── Player pool (global, shared by all leagues) ────────────────────────────

model Player {
  id              String       @id @default(cuid())
  name            String
  /// ISO 3166-1 alpha-2 (or "EU")
  country         String
  position        Position
  officeTitle     String
  status          PlayerStatus @default(ACTIVE)
  /// English Wikipedia article title (used for Media Share scoring)
  wikiTitle       String
  /// Optional home-language Wikipedia article (lang code + title)
  nativeWikiLang  String?
  nativeWikiTitle String?
  photoUrl        String?
  bio             String?
  /// Used for draft autopick & default sorting. Lower = better.
  defaultRank     Int          @default(999)
  /// Seed data may be out of date; admin clears this after checking.
  needsVerification Boolean    @default(false)
  adminNotes      String?
  leftOfficeAt    DateTime?
  /// If this player replaced someone who left office
  replacesId      String?      @unique
  replaces        Player?      @relation("Replacement", fields: [replacesId], references: [id], onDelete: SetNull)
  replacedBy      Player?      @relation("Replacement")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rosterSpots RosterSpot[]
  draftPicks  DraftPick[]
  queueItems  DraftQueueItem[]
  events      PlayerEvent[]
  dailyViews  PlayerDailyViews[]
  weekFlags   PlayerWeekFlag[]

  @@index([position])
  @@index([country])
}

/// Admin-logged scoring events (Diplomacy, Output, Survival, Elections).
model PlayerEvent {
  id          String   @id @default(cuid())
  playerId    String
  player      Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// Key from EVENT_TYPES in packages/shared/src/scoring/events.ts
  type        String
  /// Calendar date the event happened (YYYY-MM-DD). Assigned to a league's
  /// scoring week using that league's timezone.
  date        String
  note        String?
  sourceUrl   String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([playerId, date])
  @@index([date])
}

/// Daily Wikipedia pageviews (UTC days, as reported by Wikimedia). (Phase 3)
model PlayerDailyViews {
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// YYYY-MM-DD
  date     String
  enViews     Int @default(0)
  nativeViews Int @default(0)

  @@id([playerId, date])
}

/// Admin overrides for a player's week, e.g. excluding Media Share when a
/// pageview spike is due to war or disaster. (Phase 3)
model PlayerWeekFlag {
  id                 String  @id @default(cuid())
  playerId           String
  player             Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// Monday of the week (YYYY-MM-DD)
  weekStart          String
  excludeMediaShare  Boolean @default(false)
  reason             String?

  @@unique([playerId, weekStart])
}

// ─── Draft (Phase 2) ────────────────────────────────────────────────────────

model DraftPick {
  id         String   @id @default(cuid())
  leagueId   String
  league     League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  /// 1-based overall pick number
  pickNumber Int
  round      Int
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id])
  isAutopick Boolean  @default(false)
  madeAt     DateTime @default(now())

  @@unique([leagueId, pickNumber])
  @@unique([leagueId, playerId])
}

model DraftQueueItem {
  id       String @id @default(cuid())
  teamId   String
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  rank     Int

  @@unique([teamId, playerId])
}

// ─── Rosters, lineups, matchups (Phase 3) ───────────────────────────────────

model RosterSpot {
  id         String   @id @default(cuid())
  leagueId   String
  league     League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teamId     String
  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player   @relation(fields: [playerId], references: [id])
  /// Slot key in the current (unlocked) lineup, e.g. "HEAD_OF_STATE:0", "FLEX:0", or "BENCH"
  slot       String   @default("BENCH")
  acquiredAt DateTime @default(now())

  /// A player can only be on one team per league
  @@unique([leagueId, playerId])
  @@index([teamId])
}

/// Lineup snapshot taken when a week locks.
model WeeklyLineup {
  id        String @id @default(cuid())
  teamId    String
  team      Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  week      Int
  /// Array<{ slot: string; playerId: string }>
  starters  Json
  bench     Json

  @@unique([teamId, week])
}

model Matchup {
  id           String  @id @default(cuid())
  leagueId     String
  league       League  @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  week         Int
  homeTeamId   String
  homeTeam     Team    @relation("HomeTeam", fields: [homeTeamId], references: [id], onDelete: Cascade)
  /// Null = bye week
  awayTeamId   String?
  awayTeam     Team?   @relation("AwayTeam", fields: [awayTeamId], references: [id], onDelete: Cascade)
  homeScore    Float   @default(0)
  awayScore    Float   @default(0)
  /// Per-player point breakdowns, written when scored
  breakdown    Json?
  finalized    Boolean @default(false)
  isPlayoff    Boolean @default(false)
  playoffRound Int?
  homeSeed     Int?
  awaySeed     Int?

  @@index([leagueId, week])
}

// ─── Feed, chat, history ────────────────────────────────────────────────────

model Activity {
  id        String   @id @default(cuid())
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  /// e.g. JOIN, DRAFT_PICK, TRADE, RESULT, PLAYER_LEFT_OFFICE
  type      String
  message   String
  data      Json?
  createdAt DateTime @default(now())

  @@index([leagueId, createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  /// "draft" for the draft room, "league" for the league chat
  channel   String   @default("league")
  body      String
  createdAt DateTime @default(now())

  @@index([leagueId, channel, createdAt])
}

/// Past champions (Phase 4). Names are copied so history survives renames.
model ChampionRecord {
  id        String   @id @default(cuid())
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  season    Int
  teamId    String?
  teamName  String
  ownerName String
  record    String?
  createdAt DateTime @default(now())

  @@unique([leagueId, season])
}

// ─── Waivers & trades (Phase 5) ─────────────────────────────────────────────

model WaiverClaim {
  id           String   @id @default(cuid())
  leagueId     String
  league       League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  addPlayerId  String
  dropPlayerId String?
  /// PENDING | SUCCEEDED | FAILED | CANCELLED
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  processedAt  DateTime?
}

model Trade {
  id           String    @id @default(cuid())
  leagueId     String
  league       League    @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  proposerId   String
  proposer     Team      @relation("TradeProposer", fields: [proposerId], references: [id], onDelete: Cascade)
  recipientId  String
  recipient    Team      @relation("TradeRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  /// Player ids each side gives up
  proposerGives  String[]
  recipientGives String[]
  /// PROPOSED | ACCEPTED | REJECTED | CANCELLED | VETOED | COMPLETED
  status       String    @default("PROPOSED")
  message      String?
  createdAt    DateTime  @default(now())
  respondedAt  DateTime?
  /// End of the commissioner veto window
  vetoDeadline DateTime?
}
