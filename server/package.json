{
  "name": "@fp/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "build": "prisma generate && tsup",
    "start": "prisma migrate deploy && node dist/seed.js && node dist/index.js",
    "seed": "tsx --env-file-if-exists=../.env prisma/seed/index.ts",
    "migrate": "prisma migrate dev",
    "job:weekly": "node dist/weekly.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@fp/shared": "*",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.7.2",
    "prisma": "6.19.3",
    "socket.io": "^4.8.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.18.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "~5.9.3",
    "vitest": "^5.1.1"
  }
}
